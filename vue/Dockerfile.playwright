FROM mcr.microsoft.com/playwright:v1.62.0-noble@sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07

WORKDIR /workspace/vue

RUN corepack enable \
    && chown pwuser:pwuser /workspace/vue

USER pwuser

COPY --chown=pwuser:pwuser package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY --chown=pwuser:pwuser . .

CMD ["pnpm", "run", "test:e2e"]
