      "mutation": true, "destructive": false, "risk": "R2",
      "parameters": {
        "type": {"type": "string", "enum": ["manual"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 255},
        "nodeName": {"type": "string", "minLength": 1, "maxLength": 255},
        "projectId": {"type": "string", "minLength": 1, "maxLength": 64},
