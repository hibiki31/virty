              "originalPoolUuid": {"type": ["string", "null"], "maxLength": 255},
              "originalName": {"type": ["string", "null"], "maxLength": 255},
              "sizeGigaByte": {"type": ["integer", "null"], "minimum": 1},
              "templateName": {"type": ["string", "null"], "maxLength": 255}
            },
            "required": ["type", "savePoolUuid"],
            "additionalProperties": false
          }
        },
        "interface": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "type": {"type": "string", "minLength": 1, "maxLength": 64},
