              "networkUuid": {"type": "string", "minLength": 1, "maxLength": 255},
              "port": {"type": ["string", "null"], "maxLength": 255}
            },
            "required": ["type", "networkUuid"],
            "additionalProperties": false
          }
        },
        "cloudInit": {
          "type": ["object", "null"],
          "properties": {
            "hostname": {"type": "string", "minLength": 1, "maxLength": 255},
            "userData": {"type": "string", "maxLength": 1048576, "writeOnly": true}
          },
          "required": ["hostname", "userData"],
          "additionalProperties": false
        }
      },
      "required": ["type", "name", "nodeName", "projectId", "memoryMegaByte", "cpu", "disks", "interface"],
      "target": {"resourceType": "vm", "resourceIdField": "name", "projectIdField": "projectId", "nodeIdField": "nodeName"}
