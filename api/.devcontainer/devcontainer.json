{
	"name": "virty-api",
	"dockerComposeFile": "../../compose.dev.yml",
	"service": "api",
	"runServices": ["db", "migrate", "api", "worker"],
	"workspaceFolder": "/workspace/api",
	"initializeCommand": [
		"bash",
		"-lc",
		"repo=$(git -C \"$1\" rev-parse --show-toplevel) && exec \"$repo/scripts/init-devcontainer-project.sh\" \"$1\"",
		"bash",
		"${localWorkspaceFolder}"
	],
	"remoteUser": "virty",
	"updateRemoteUserUID": true,
	"shutdownAction": "stopCompose",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"mhutchie.git-graph",
				"KevinRose.vsc-python-indent",
				"charliermarsh.ruff",
				"tamasfe.even-better-toml",
				"saoudrizwan.claude-dev",
				"tanggod.json-log-viewer"
			]
		}
	}
}
